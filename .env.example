# =================================================================
# IP-SAKTI Sahayak - Environment Configuration Template
# Copy to .env and fill in. Never commit .env.
# =================================================================

# --- App ---------------------------------------------------------
# development | production
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Database (Postgres + pgvector; `docker compose up -d postgres`) ---
DATABASE_URL=postgresql+psycopg://ipsakti:ipsakti@localhost:5433/ipsakti
# blank = same database (pgvector)
VECTOR_DATABASE_URL=

# --- Auth (REQUIRED in production: long random strings) -----------
JWT_SECRET=
SESSION_SECRET=

# --- LLM: grok | openai | deepseek | mock -------------------------
# mock = extractive answers built only from retrieved passages (no API key needed)
LLM_PROVIDER=mock
LLM_API_KEY=
# default: grok-3-mini (grok) / gpt-4o-mini (openai) / deepseek-chat (deepseek)
LLM_MODEL=
# optional; grok defaults to https://api.x.ai/v1
LLM_BASE_URL=

# --- Embeddings: openai | hashing | bge_m3 | mock -----------------
# hashing = local character n-gram embeddings (offline, no key). DeepSeek has no
# embeddings API, so use hashing or openai (with EMBEDDING_API_KEY) alongside it.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024

# --- Optional ----------------------------------------------------
REDIS_URL=
STORAGE_PROVIDER=local
STORAGE_BUCKET=
PATENT_API_URL=
PUBMED_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
